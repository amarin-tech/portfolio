---
const { title, subtitle, type } = Astro.props;
---

<div class="flex group">
  <div class="education__time flex flex-col items-center mr-6">
    <span class="w-4 h-4 bg-base-100 border-4 border-base-content/20 group-hover:border-base-content block rounded-full mt-7 transition-colors duration-300"></span>
    <span class="education__line bg-base-content/10 group-hover:bg-base-content/30 block h-full w-[2px] transition-colors duration-300 mt-2"></span>
  </div>
  <div class="experience__data w-full pb-8">
    <div class="bg-base-200/40 rounded-2xl p-6 border border-base-content/10 group-hover:border-base-content/30 group-hover:shadow-lg transition-all duration-300">
      <div class="flex justify-between items-start flex-wrap gap-2 mb-1">
        <h3 class="font-bold text-xl">{title}</h3>
        {type && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border-2 border-base-content/20 bg-base-100/50 text-sm font-medium text-base-content/80 whitespace-nowrap shadow-sm mt-0.5">
            {type === 'education' ? '🎓 Educación' : '💼 Experiencia'}
          </span>
        )}
      </div>
      <span class="font-medium text-base-content/60 text-sm uppercase tracking-wider">{subtitle}</span>
      {Astro.slots.has('default') && (
        <div class="mt-4 text-base-content/80 text-justify leading-relaxed">
          <slot />
        </div>
      )}
    </div>
  </div>
</div>
