---
import { Image } from "astro:assets";
const { id, title, img, shortDesc, longDesc, githubUrl, badge, images = [] } = Astro.props;
---

<details id={id} class="collapse collapse-arrow bg-base-100 hover:shadow-xl transition-all duration-300 ease-in-out mb-4 group border border-base-300 scroll-mt-20">
  <summary class="collapse-title p-0 m-0 min-h-0 cursor-pointer">
    <div class="hero-content flex-col md:flex-row items-start md:items-center">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg group-hover:scale-[102%] transition-transform duration-300"
          />
        )
      }
      <div class="grow w-full text-left pl-2 pr-6">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-base text-base-content/80 font-normal leading-relaxed">{shortDesc}</p>
      </div>
    </div>
  </summary>
  
  <div class="collapse-content px-6 md:px-10 pb-6 pt-2">
    <div class="divider mt-0 mb-6"></div>
    
    <div class="text-base text-base-content mb-8 leading-relaxed whitespace-pre-line" set:html={longDesc.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
    
    <div class="mb-8">
      <h3 class="font-bold text-lg mb-4">Galería de Imágenes</h3>
      {images.length > 0 ? (
        <div class="carousel carousel-center max-w-full p-4 space-x-4 bg-base-200 rounded-2xl">
          {images.map((image) => (
            <div class="carousel-item">
              <img src={image} class="rounded-xl h-48 md:h-64 object-cover shadow-sm border border-base-300" alt={`Screenshot of ${title}`} />
            </div>
          ))}
        </div>
      ) : (
        <div class="tape-container relative w-full h-48 md:h-64 bg-base-200/30 rounded-2xl overflow-hidden border-2 border-dashed border-base-content/20 flex items-center justify-center opacity-40 hover:opacity-100 transition-opacity duration-500 cursor-default">
          <!-- Banda 1 (detrás, más pequeña) -->
          <div class="absolute w-[150%] md:w-[120%] h-10 bg-base-300 border-y-2 border-base-content/20 shadow-xl transform -rotate-6 flex items-center z-10 opacity-70 text-base-content/60 font-black text-sm md:text-base tracking-widest overflow-hidden">
             <div class="flex whitespace-nowrap animate-marquee-reverse">
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
             </div>
          </div>
          <!-- Banda 2 (delante, más grande) -->
          <div class="absolute w-[150%] md:w-[120%] h-14 bg-base-300 border-y-2 border-base-content/20 shadow-2xl transform rotate-6 flex items-center z-20 opacity-100 text-base-content/90 font-black text-xl md:text-2xl tracking-widest overflow-hidden">
             <div class="flex whitespace-nowrap animate-marquee">
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
               <span class="mx-6">🚧 TRABAJO EN CURSO</span>
             </div>
          </div>
        </div>
      )}
    </div>

    <div class="flex justify-end mt-4">
      <a href={githubUrl} target="_blank" class="btn btn-outline border-2 rounded-xl hover:bg-base-content hover:text-base-100 transition-colors">
        <svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
        Ver código en GitHub
      </a>
    </div>
  </div>
</details>

<style>
  .animate-marquee {
    animation: marquee 60s linear infinite;
    animation-play-state: paused;
  }
  .animate-marquee-reverse {
    animation: marquee 60s linear infinite reverse;
    animation-play-state: paused;
  }
  .tape-container:hover .animate-marquee,
  .tape-container:hover .animate-marquee-reverse {
    animation-play-state: running;
  }
  @keyframes marquee {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }
</style>
